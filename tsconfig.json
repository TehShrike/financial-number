{
	"compilerOptions": {
		"module": "esnext",
		"noImplicitAny": true,
		"diagnostics": true,
		"noImplicitThis": true,
		"noEmitOnError": true,
		"target": "esnext",
		"lib": ["esnext", "dom"],
		"moduleResolution": "node",
		"allowSyntheticDefaultImports": true,
		"allowImportingTsExtensions": true,
		"declaration": true,
		"emitDeclarationOnly": true,
	},
	"include": [
		"*.ts",
		"test/*.ts"
	],
	"exclude": [
		"node_modules",
		"*.d.ts"
	]
}
